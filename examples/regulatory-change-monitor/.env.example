# Copy to .env (never commit it). Keys are read from the environment only.
# Create a LexAPI key at https://lex-api.com/dashboard?ref=github-examples
LEXAPI_API_KEY=

# Model provider: anthropic (default) or openai.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OPENAI_API_KEY=
# OPENAI_MODEL=            # required when LLM_PROVIDER=openai; there is no default

# Webhook mode only (paid plans):
# LEXAPI_WEBHOOK_URL=https://your-host.example/webhooks/lexapi
# LEXAPI_WEBHOOK_SECRET=   # printed once by `npm run monitor:webhook-setup`
# PORT=8787
